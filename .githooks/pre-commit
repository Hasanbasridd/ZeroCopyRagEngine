#!/bin/sh

# Cyber-Guard Pre-Commit Hook
# Prevents memory-allocating methods in high-performance paths.
#
# Layer 1: Roslyn ClrHeapAllocationAnalyzer (HAA0101-HAA0603 as build errors in .editorconfig).
# Layer 2: Banned-method scan below, which also covers `yield return` iterator bodies
#          that ClrHeapAllocationAnalyzer skips.
# Note: In .NET 9, ReadOnlySpan<char>.Split(...) returns a stack-only SpanSplitEnumerator<char>
#       (0 B allocation). It may be exempted with an inline comment:
#       // cyber-guard: allow-span-split (<reason>)

FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '(Chunkers|VectorStores)/.*\.cs$')

if [ -z "$FILES" ]; then
    exit 0
fi

REJECT=0
for file in $FILES; do
    VIOLATIONS=$(grep -nE '\.Select\(|\.ToList\(|\.Split\(' "$file" | grep -vE '\.Split\(.*// cyber-guard: allow-span-split \(.+\)' || true)
    if [ -n "$VIOLATIONS" ]; then
        echo "🚨 CYBER-GUARD ALERT: Banned method (.Select, .ToList, or unapproved .Split) detected in $file:"
        echo "$VIOLATIONS"
        echo "Commit rejected to maintain Zero-Copy & Zero-Allocation Discipline!"
        REJECT=1
    fi
done

if [ $REJECT -eq 1 ]; then
    exit 1
fi

exit 0
